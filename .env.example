# Hebrew Voice Generator configuration.
# Copy to .env for local development, or install as /etc/hebrew-voice/env on a
# server. Real environment variables always win over this file.

# --- core -------------------------------------------------------------------
HV_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HV_SECRET_KEY=change-me
HV_DATA_DIR=/var/lib/hebrew-voice
# Defaults to ${HV_DATA_DIR}/hebrew-voice.db
#HV_DB_PATH=

# --- serving ----------------------------------------------------------------
HV_HOST=127.0.0.1
HV_PORT=8080

# Docker only: the host port published on 127.0.0.1, which nginx proxies to.
# Change it if 8080 is already taken on the box - the container still listens
# on 8080 internally, so nothing else moves.
#HV_PUBLISH_PORT=8095
# Full public URL, INCLUDING any subpath. Required in production.
# Two jobs: unsafe requests from any other origin are refused, and the path
# component becomes the prefix on every link, redirect, and cookie the app
# emits. Serving at the root of a hostname:
#     HV_BASE_URL=https://voice.example.com
# Sharing a hostname with another app:
#     HV_BASE_URL=https://srv1515969.hstgr.cloud/voice-gen
HV_BASE_URL=https://voice.example.com

# The URL prefix the app is served under. Leave empty - it is derived from
# HV_BASE_URL's path. Set it only if the proxy's public path differs from the
# base URL you advertise.
#HV_ROOT_PATH=
# Take the client IP from X-Forwarded-For. Correct behind nginx; turn off if
# the app is exposed directly, or the rate limits can be spoofed.
HV_TRUST_PROXY=true
HV_LOG_LEVEL=info

# --- accounts ---------------------------------------------------------------
HV_SECURE_COOKIES=true
HV_SESSION_TTL_DAYS=30
HV_SIGNUP_ENABLED=true
# Comma-separated. Signup requires one of these; leaving it empty while signup
# is enabled refuses to boot in production.
HV_INVITE_CODES=
HV_MAX_FAILED_LOGINS=10
HV_LOCKOUT_MINUTES=15

# --- email ------------------------------------------------------------------
# New accounts must confirm their address before they can do anything. Turn
# this off only if you're gating registration some other way.
HV_REQUIRE_EMAIL_VERIFICATION=true
HV_VERIFY_TOKEN_TTL_HOURS=24

# Gmail relay. A VPS cannot deliver to Gmail on its own - port 25 outbound is
# usually blocked and unauthenticated mail is discarded - so a relay is not
# optional.
#
# To get HV_SMTP_PASSWORD:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password; Google shows 16 characters in four groups.
#   4. Paste it here WITHOUT the spaces.
# It is not your Google password, and it only works with 2-Step Verification on.
#
# Leaving HV_SMTP_HOST empty logs messages instead of sending them, which is
# handy locally but refused at startup in production while verification is on.
HV_SMTP_HOST=smtp.gmail.com
HV_SMTP_PORT=587
HV_SMTP_USER=you@gmail.com
HV_SMTP_PASSWORD=
# Defaults to HV_SMTP_USER. Gmail rewrites the sender to the authenticated
# account anyway, so this is advisory.
#HV_SMTP_FROM=
HV_SMTP_FROM_NAME=מחולל קול עברי
HV_SMTP_STARTTLS=true
HV_SMTP_TIMEOUT=15

# --- limits -----------------------------------------------------------------
HV_MAX_CHARS=10000
HV_DAILY_CHAR_QUOTA=50000
HV_QUOTA_TZ=Asia/Jerusalem
HV_RATE_LIMIT_PER_MIN=6
HV_RATE_LIMIT_BURST=3
HV_MAX_CONCURRENT_SYNTH=3
HV_MAX_CONCURRENT_PER_USER=1
HV_MAX_QUEUE=10
HV_QUEUE_WAIT_TIMEOUT=20
# Keep nginx's proxy_read_timeout comfortably above this.
HV_SYNTH_TIMEOUT=180
HV_THREAD_POOL_SIZE=16

# --- video rendering --------------------------------------------------------
# Where the HyperFrames sidecar listens. Leave this empty and the app hides
# everything about video - no button, no endpoints, no worker. docker-compose
# sets it for you; it is here for installs that run the app outside Compose.
#HV_RENDER_URL=http://hyperframes:8080
# Where the RENDERER sees the data directory. Only needed when the two
# processes disagree about it - running the app on the host against a
# containerised renderer, say. Defaults to HV_DATA_DIR.
#HV_RENDER_DATA_DIR=/data
# One at a time by default: a render is a browser plus an encoder, and two at
# once on a small box is slower than two in a row.
HV_MAX_CONCURRENT_RENDERS=1
# Videos per account per day. Far scarcer than characters - a render costs
# minutes of CPU, a synthesis costs a second.
HV_DAILY_RENDER_QUOTA=10
# Give up on a single render after this long.
HV_RENDER_TIMEOUT=900
# Refuse to render audio longer than this. Render time scales with duration.
HV_MAX_RENDER_SECONDS=300
# Default frame shape: vertical (1080x1920), square (1080x1080) or landscape
# (1280x720). The result card can pick another per render. Vertical is the
# default because a caption overlay has to match the footage it goes over, and
# short-form video is what these are mostly for.
#
# Vertical is also the most expensive: 2.07M pixels against landscape's 0.92M,
# so roughly twice the render time. Measure on your own box.
HV_RENDER_SIZE=vertical
# 24, 30 or 60.
HV_RENDER_FPS=30
# draft | standard | high
HV_RENDER_QUALITY=standard

# Photos and clips uploaded to show behind the captions.
# Largest single file. Video reaches this far sooner than photos do.
HV_MAX_UPLOAD_BYTES=67108864
# Total an account may keep. The renderer reads the files off disk, so this is
# the real limit on what uploads cost the box - watch it before raising.
HV_MEDIA_QUOTA_BYTES=536870912
# Most clips in one video.
HV_MAX_MEDIA_PER_RENDER=20

# --- retention --------------------------------------------------------------
HV_HISTORY_KEEP=50
HV_HISTORY_MAX_AGE_DAYS=30
HV_CLEANUP_INTERVAL_MIN=60

# --- engine -----------------------------------------------------------------
# Outbound proxy for reaching the Edge TTS service, if your network needs one.
#HV_EDGE_PROXY=
HV_SYNTH_RETRIES=2
