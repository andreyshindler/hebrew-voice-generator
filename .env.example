# Hebrew Voice Generator configuration.
# Copy to .env for local development, or install as /etc/hebrew-voice/env on a
# server. Real environment variables always win over this file.

# --- core -------------------------------------------------------------------
HV_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HV_SECRET_KEY=change-me
HV_DATA_DIR=/var/lib/hebrew-voice
# Defaults to ${HV_DATA_DIR}/hebrew-voice.db
#HV_DB_PATH=

# --- serving ----------------------------------------------------------------
HV_HOST=127.0.0.1
HV_PORT=8080
# Full public URL, INCLUDING any subpath. Required in production.
# Two jobs: unsafe requests from any other origin are refused, and the path
# component becomes the prefix on every link, redirect, and cookie the app
# emits. Serving at the root of a hostname:
#     HV_BASE_URL=https://voice.example.com
# Sharing a hostname with another app:
#     HV_BASE_URL=https://srv1515969.hstgr.cloud/voice-gen
HV_BASE_URL=https://voice.example.com

# The URL prefix the app is served under. Leave empty - it is derived from
# HV_BASE_URL's path. Set it only if the proxy's public path differs from the
# base URL you advertise.
#HV_ROOT_PATH=
# Take the client IP from X-Forwarded-For. Correct behind nginx; turn off if
# the app is exposed directly, or the rate limits can be spoofed.
HV_TRUST_PROXY=true
HV_LOG_LEVEL=info

# --- accounts ---------------------------------------------------------------
HV_SECURE_COOKIES=true
HV_SESSION_TTL_DAYS=30
HV_SIGNUP_ENABLED=true
# Comma-separated. Signup requires one of these; leaving it empty while signup
# is enabled refuses to boot in production.
HV_INVITE_CODES=
HV_MAX_FAILED_LOGINS=10
HV_LOCKOUT_MINUTES=15

# --- limits -----------------------------------------------------------------
HV_MAX_CHARS=10000
HV_DAILY_CHAR_QUOTA=50000
HV_QUOTA_TZ=Asia/Jerusalem
HV_RATE_LIMIT_PER_MIN=6
HV_RATE_LIMIT_BURST=3
HV_MAX_CONCURRENT_SYNTH=3
HV_MAX_CONCURRENT_PER_USER=1
HV_MAX_QUEUE=10
HV_QUEUE_WAIT_TIMEOUT=20
# Keep nginx's proxy_read_timeout comfortably above this.
HV_SYNTH_TIMEOUT=180
HV_THREAD_POOL_SIZE=16

# --- retention --------------------------------------------------------------
HV_HISTORY_KEEP=50
HV_HISTORY_MAX_AGE_DAYS=30
HV_CLEANUP_INTERVAL_MIN=60

# --- engine -----------------------------------------------------------------
# Outbound proxy for reaching the Edge TTS service, if your network needs one.
#HV_EDGE_PROXY=
HV_SYNTH_RETRIES=2
