# Serving the Hebrew Voice Generator under a subpath, alongside another app.
#
# Use this when the hostname's root already belongs to something else - e.g.
# srv1515969.hstgr.cloud serves occy at / and the voice generator at
# /voice-gen/. Paste these two blocks INTO the existing `server { ... }` for
# the hostname; do not add a second server block.
#
# The app must be told its public URL so the links, redirects, and cookies it
# emits carry the prefix:
#
#     HV_BASE_URL=https://srv1515969.hstgr.cloud/voice-gen
#
# That single setting also derives HV_ROOT_PATH.

# /voice-gen -> /voice-gen/  (without this, the browser resolves relative URLs
# against /, and the page loads with no CSS).
location = /voice-gen {
    return 301 /voice-gen/;
}

location /voice-gen/ {
    # The trailing slash on proxy_pass strips the /voice-gen/ prefix before
    # forwarding. The app also tolerates the prefix arriving intact, so
    # `proxy_pass http://127.0.0.1:8080;` works too - but keep the slash: it
    # is the conventional form and keeps the app's logs root-relative.
    proxy_pass http://127.0.0.1:8080/;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Must exceed HV_SYNTH_TIMEOUT (default 180s). With nginx's 60s default a
    # long job returns a 504 to the browser while the app quietly finishes and
    # files the result in history - a confusing failure to debug.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Audio is served with range support; don't buffer it whole.
    proxy_buffering off;

    # The API is JSON-only and text is capped by HV_MAX_CHARS.
    client_max_body_size 1m;
}

# Static assets are served by the app (they live inside the container). If you
# ever run natively and want nginx to serve them straight off disk, add:
#
# location /voice-gen/static/ {
#     alias /opt/hebrew-voice/hebrew_voice/web/static/;
#     expires 7d;
#     access_log off;
# }
